# Copy to .env and fill in. Never commit .env.

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5180
# Signs the login cookie: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared with the Cloudflare Worker that triggers the scheduled sync
CRON_SECRET=

# MongoDB Atlas
MONGODB_URI=

# Google sign-in and Gmail (read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Groq: gpt-oss-20b for classification, RAG answers and question rewriting
GROQ_API_KEY=

# Cloudflare Workers AI: bge-m3 embeddings (token with the "Workers AI" template)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional, evaluation only: Laya via Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Jev via OpenRouter: the main classifier (gpt-oss-20b on Groq is the fallback)
OPENROUTER_API_KEY=
